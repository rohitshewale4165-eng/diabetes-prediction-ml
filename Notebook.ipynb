num_features = len(diabetes_dataset.columns[:-1])
ncols = 3 # To arrange plots in 3 columns
nrows = (num_features + ncols - 1) // ncols # Calculate rows needed

fig, axes = plt.subplots(nrows=nrows, ncols=ncols, figsize=(15, nrows * 4)) # Adjust figsize dynamically
axes = axes.flatten() # Flatten the 2D array of axes for easier indexing

features_to_plot = diabetes_dataset.columns[:-1] # Corrected attribute name

for idx, feature_name in enumerate(features_to_plot):
  ax = axes[idx] # Get the current axis object

  for outcome in [0,1]:
    data = diabetes_dataset[diabetes_dataset['Outcome']==outcome][feature_name]
    ax.hist(data, bins=20, alpha=0.5, label=f'Outcome {outcome}') # Added missing parenthesis
  ax.set_xlabel(feature_name)
  ax.set_ylabel('count')
  ax.legend()

# Remove any unused subplots if num_features is not a perfect multiple of ncols
for i in range(num_features, len(axes)):
    fig.delaxes(axes[i])

plt.tight_layout()
